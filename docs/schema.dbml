// SpecVault database schema diagram
// -----------------------------------
// Simplified visualization of supabase/schema.sql
// Used to generate ER diagram
// -----------------------------------
// Created: 03/09/2026
// Updated: 11/01/2026


Table items {
  id uuid [pk]
  name text
  description text
  acquired_date date
  created_at timestamptz
  updated_at timestamptz
  subcollection text
  theme text
  acquisition_cost numeric
  acquisition_currency char(3)
  acquisition_format text
  obtained_from text
  is_autographed boolean [not null, default: false]
}

Table coins {
  item_id uuid [pk]
  denomination numeric
  currency text
  year integer
  country text
  mint text
  mint_code text
  composition text
  edge text
  finish text
  weight numeric
  diameter numeric
  mark text
  prog_theme text
  condition text
  mintage bigint
  notes text
}

Table banknotes {
  item_id uuid [pk]
  denomination numeric
  currency text
  country text
  issuer text
  material text
  issue_date date
  issue_date_precision text
  width numeric
  height numeric
  series text
  condition text
  notes text
}

Table trading_cards {
  item_id uuid [pk]

  title text
  card_date date
  card_date_precision text
  card_number text
  serial_number text
  brand text
  set_name text
  product_line text
  card_family text
  subset text
  parallel text
  badges text[]
  sport_or_topic text [not null]
  tournament text
  condition text
  dimensions text [not null, default: '2.5" x 3.5"']
  front_orientation text
  back_orientation text
  is_wrapper_stored boolean [not null, default: false]
  autograph_type text [not null, default: 'Not autographed']
  product_type text
  available_from_date date
  available_to_date date
  print_run integer
  theme text
  notes text
}

// Renamed from players in migration 043.
Table card_subjects {
  id uuid [pk]
  first_name text [not null]
  last_name text [not null]
  nationality char(2)
  birth_year integer
  primary_position text
  notes text

  // CHECK constraints (renamed in migration 044):
  // chk_card_subjects_birth_year_range
  // chk_card_subjects_nationality_format
  // chk_card_subjects_prim_pos_format
}

// Renamed from trading_card_players in migration 043.
Table subject_appearances {
  trading_card_id uuid [not null]
  subject_id uuid [not null]
  subject_order smallint [not null]
  team_name text
  jersey_number smallint
  position text

  indexes {
    (trading_card_id, subject_id) [pk, name: 'subject_appearances_pkey']
    (trading_card_id, subject_order) [unique, name: 'uq_subject_appearance_order']
  }

  // CHECK constraints (renamed in migration 044):
  // chk_subject_order_range
  // chk_subject_jersey_number_range
  // chk_subject_appearances_position_format
}

Table stamps {
  item_id uuid [pk]
  country text
  issue_year integer
  issue_date date
  denomination_text text
  currency text
  stamp_type text
  format text
  perforation text
  watermark text
  printing_method text
  main_color text
  condition text
  is_on_cover boolean
  catalog_system text
  catalog_number text
  notes text
}

Table taxa {
  id uuid [pk]
  tax_name text
  rank text
  parent_id uuid
  authority text
  common_name text
  type_locality text
  notes text
}

Table specimens {
  item_id uuid [pk, ref: > items.id]
  taxon_id uuid [not null, unique, ref: > taxa.id]
  sex text
  wingspan_mm numeric(5,2)
  dorsal_main_color text
  ventral_main_color text
  notes text

  // Owned Lepidoptera specimen records. 
  // Current project scope allows at most one specimen per represented species/subspecies.
}

Table distribution_areas {
  code text [pk]
  name text
  area_type text
  parent_code text
  notes text

  // Hierarchical geographic regions used to describe
  // taxon occurrence/distribution.
}

Table taxon_dist_areas {
  taxon_id uuid
  area_code text
  occurrence_status text
  notes text
  
  indexes {
    (taxon_id, area_code) [pk]
    area_code [name: 'idx_taxon_dist_areas_area_code']
    taxon_id [name: 'idx_taxon_dist_areas_taxon_id']
  }

  // many-to-many relation between taxa and geographic distribution areas where they occur
}

// Relationships

Ref: coins.item_id > items.id
Ref: banknotes.item_id > items.id
Ref: trading_cards.item_id > items.id
Ref: stamps.item_id > items.id

Ref: subject_appearances.trading_card_id > trading_cards.item_id
Ref: subject_appearances.subject_id > card_subjects.id

Ref: taxa.parent_id > taxa.id
Ref: distribution_areas.parent_code > distribution_areas.code
Ref: taxon_dist_areas.taxon_id > taxa.id
Ref: taxon_dist_areas.area_code > distribution_areas.code
