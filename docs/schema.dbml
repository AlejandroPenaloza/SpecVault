// SpecVault database schema diagram
// -----------------------------------
// Simplified visualization of supabase/schema.sql
// Used to generate ER diagram
// -----------------------------------
// Created: 03/09/2026
// Updated: 11/28/2026


Table items {
  id uuid [pk]
  name text [not null]
  description text
  acquired_date date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  subcollection text
  // Personal organization across all collectible types; unlike trading_cards.theme,
  // this is a user-defined array of categories, not a card-specific theme
  theme "text[]" [not null, default: '{}']
  acquisition_cost numeric
  acquisition_currency char(3)
  acquisition_format text
  obtained_from text
  // Collection-wide autograph indicator. For trading cards, this is derived from
  // the authoritative trading_cards.autograph_type by synchronization triggers.
  is_autographed boolean [not null, default: false]
}

Table coins {
  item_id uuid [pk]
  denomination numeric
  currency text
  year integer
  country text
  mint text
  mint_code text
  composition text
  edge text
  finish text
  weight numeric
  diameter numeric
  mark text
  prog_theme text
  condition text
  mintage bigint
  notes text
}

Table banknotes {
  item_id uuid [pk]
  denomination numeric
  currency text
  country text
  issuer text
  material text
  issue_date date
  issue_date_precision text
  width numeric
  height numeric
  series text
  condition text
  notes text
}

Table trading_cards {
  item_id uuid [pk]
  title text
  card_date date
  card_date_precision text
  card_date_format text
  card_number text
  serial_number text
  brand text
  set_name text
  product_line text
  card_family text
  subset text
  parallel text
  badges "text[]"
  sport_or_topic text [not null]
  tournament text
  condition text
  dimensions text [not null, default: '2.5" x 3.5"']
  thickness numeric [not null, default: 35, note: 'Thickness in points (pt)']
  front_orientation text
  back_orientation text
  is_wrapper_stored boolean [not null, default: false]

  // Authoritative autograph classification for trading cards. The triggers
  // synchronize items.is_autographed: 'Not autographed' and 'Facsimile' -> false;
  // all other non-NULL classifications -> true.
  autograph_type text [not null, default: 'Not autographed']
  relic_type text
  product_type text
  available_from_date date
  available_to_date date
  print_run integer

  // Card-specific theme (design/product/subject), distinct from the personal,
  // multi-valued organizational themes stored in items.theme.
  theme text
  notes text

  // CHECK constraints:
  // chk_trading_cards_dimensions_format
  // chk_trading_cards_date_precision
  // chk_trading_cards_date_format
  // chk_trading_cards_thickness_positive
  // chk_trading_cards_front_orientation
  // chk_trading_cards_back_orientation
  // chk_trading_cards_print_run_positive
  // chk_trading_cards_topps_now_start_date
  // chk_trading_cards_availability_dates

  // Trigger functions:
  // sync_trading_card_autograph() via trg_sync_trading_card_autograph
  // validate_item_autograph() via trg_validate_item_autograph (on items)
}

Table card_subjects {
  id uuid [pk]
  first_name text [not null]
  last_name text [not null]
  nationality char(2)
  birth_year integer
  primary_position text
  notes text

  // CHECK constraints:
  // chk_card_subjects_birth_year_range
  // chk_card_subjects_nationality_format
  // chk_card_subjects_prim_pos_format
}

Table subject_appearances {
  trading_card_id uuid [not null]
  subject_id uuid [not null]
  subject_order smallint [not null, note: 'Subject position order in card (1-4)']
  team_name text
  jersey_number smallint
  position text

  indexes {
    (trading_card_id, subject_id) [pk, name: 'subject_appearances_pkey']
    (trading_card_id, subject_order) [unique, name: 'uq_subject_appearance_order']
  }

  // CHECK constraints:
  // chk_subject_order_range
  // chk_subject_jersey_number_range
  // chk_subject_appearances_position_format
}

Table stamps {
  item_id uuid [pk]
  country text
  issue_year integer
  issue_date date
  denomination_text text
  currency text
  stamp_type text
  format text
  perforation text
  watermark text
  printing_method text
  main_color text
  condition text
  is_on_cover boolean [not null, default: false]
  catalog_system text
  catalog_number text
  notes text
}

Table taxa {
  id uuid [pk]
  tax_name text [not null]
  rank text [not null]
  parent_id uuid
  authority text
  common_name text
  type_locality text
  notes text
}

Table specimens {
  item_id uuid [pk, ref: - items.id]
  taxon_id uuid [not null, unique, ref: - taxa.id]
  sex text
  wingspan_mm numeric(5,2)
  dorsal_main_color text
  ventral_main_color text
  notes text

  // Owned Lepidoptera specimen records. 
  // Current project scope allows at most one specimen per represented species/subspecies.
}

Table distribution_areas {
  code text [pk]
  name text [not null]
  area_type text [not null]
  parent_code text
  notes text

  // Hierarchical geographic regions used to describe
  // taxon occurrence/distribution.
}

Table taxon_dist_areas {
  taxon_id uuid
  area_code text [not null]
  occurrence_status text
  notes text
  
  indexes {
    (taxon_id, area_code) [pk]
    area_code [name: 'idx_taxon_dist_areas_area_code']
    taxon_id [name: 'idx_taxon_dist_areas_taxon_id']
  }

  // many-to-many relation between taxa and geographic distribution areas where they occur
}

// Relationships

Ref: coins.item_id - items.id
Ref: banknotes.item_id - items.id
Ref: trading_cards.item_id - items.id
Ref: stamps.item_id - items.id

Ref: subject_appearances.trading_card_id > trading_cards.item_id
Ref: subject_appearances.subject_id > card_subjects.id

Ref: taxa.parent_id > taxa.id
Ref: distribution_areas.parent_code > distribution_areas.code
Ref: taxon_dist_areas.taxon_id > taxa.id
Ref: taxon_dist_areas.area_code > distribution_areas.code
